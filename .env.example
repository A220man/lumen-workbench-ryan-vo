# Lumen Workbench Environment Configuration
# Copy this file to .env and fill in required values for your deployment.

# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL=sqlite:///data/lumen.db
# For PostgreSQL in Docker / production:
# DATABASE_URL=postgresql://lumen:changeme@db:5432/lumen
DB_PASSWORD=

# ==============================================================================
# Application & Security Settings
# ==============================================================================
HOST=127.0.0.1
PORT=8000
LUMEN_SECRET_KEY=
LUMEN_DEBUG=false
LUMEN_DATA_DIR=data

# ==============================================================================
# Local Demo Mode (Localhost development only - refused in production)
# ==============================================================================
LUMEN_DEMO_MODE=true
LUMEN_DEMO_USER_EMAIL=demo@localhost
LUMEN_DEMO_USER_NAME=Demo User
LUMEN_DEMO_USER_ROLE=operator

# ==============================================================================
# OpenID Connect / Keycloak Authentication
# ==============================================================================
OIDC_ENABLED=false
OIDC_PROVIDER_URL=http://localhost:8080/realms/lumen
OIDC_CLIENT_ID=lumen-workbench
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
OIDC_ALLOWED_ROLES=viewer,operator,admin
OIDC_DEFAULT_ROLE=viewer
OIDC_AUDIENCE=lumen
KEYCLOAK_ADMIN_PASSWORD=

# ==============================================================================
# LLM Advisory Service (Opt-in, advisory explanations only)
# Supported providers: openai-compatible, anthropic, gemini, ollama
# ==============================================================================
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=512
